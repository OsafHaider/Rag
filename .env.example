# Shared local development configuration for the backend and frontend.
APP_ENV=development
VITE_API_BASE_URL=http://localhost:8000

# Use a URL-safe local password so Compose can build the container connection URL.
POSTGRES_USER=raguser
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_DB=ragdb
DATABASE_URL_LOCAL=postgresql://raguser:replace-with-a-strong-local-password@localhost:5433/ragdb

# Configure this only in Render's API service environment; do not use the local database here.
DATABASE_URL_PRODUCTION=

# Add your Groq API key before using chat.
GROQ_API_KEY=

# Redis is used by a locally run API. Docker Compose overrides this URL.
CACHE_ENABLED=true
REDIS_URL=redis://localhost:6379/0

# Set this in Render's API service to your frontend's exact HTTPS origin.
CORS_ORIGINS=http://localhost:5173

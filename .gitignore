# =====================================================
# Shared project ignore rules for both client and server
# =====================================================

# Node / frontend artifacts
**/node_modules/
**/dist/
**/build/
**/.vite/
**/.eslintcache
**/*.tgz

# Package manager logs
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# Python backend artifacts
**/.venv/
**/venv/
**/ENV/
**/env/
**/__pycache__/
**/*.py[cod]
**/*.pyo
**/*.pyd
**/*.pyc
**/*.so
**/*.egg-info/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/.coverage.*
**/htmlcov/
**/coverage/

# Environment / secrets
.env
.env.*
!.env.example

# OS / editor junk
**/.DS_Store
**/Thumbs.db
**/.vscode/
**/.idea/
**/*.swp
**/*.swo
**/*.suo
**/*.ntvs*
**/*.njsproj
**/*.sln

# Packaging / build caches
**/develop-eggs/
**/eggs/
**/parts/
**/sdist/
**/var/
**/wheels/
**/pip-wheel-metadata/

# Local runtime data
**/.cache/
**/.tmp/
**/.temp/

# Lock files (optional depending on repo preference)
# Uncomment if you do not want to track generated lockfiles for one side.
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
# uv.lock
